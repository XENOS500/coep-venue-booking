{
  "name": "@coep/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "account:provision": "node --env-file-if-exists=.env scripts/provision-account.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
