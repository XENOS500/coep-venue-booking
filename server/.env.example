DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
# Set to 1 only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
# Required for requester email OTP signup. Existing logins work without these.
# Authorize the Gmail sender once with gmail.send scope; see docs/gmail-setup.md.
# GMAIL_CLIENT_ID=your_google_oauth_client_id
# GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_google_refresh_token
# GMAIL_SENDER_EMAIL=your_authorized_gmail_address
# Separate disposable database only. Integration tests erase its data.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coep_test"
